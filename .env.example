# FTP Deployment Configuration
# Copy this to .env and fill in your values (this .env is gitignored).
#
# Live host: Network Solutions "Basic Windows Hosting" (vDeck).
# Use PLAIN FTP on PORT 21 — SFTP ports (22 / 2222 / 2121) are closed.
# The FTP username/password come from NetSol -> Hosting -> FTP Management.
FTP_HOST=ftp.rabitlearning.com
FTP_USER=your_ftp_username
FTP_PASS=your_ftp_password
# rivet-studio.com (add-on domain) serves from the FTP login ROOT.
# Leave this EMPTY to deploy to the doc root. If NetSol's "root folder"
# mapping changes, set the subfolder path here (no leading slash).
FTP_REMOTE_PATH=
